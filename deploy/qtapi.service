[Unit]
Description=QTapi cache server (FastAPI + poller + MenthorQ fetcher)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/QTapi
ExecStart=/root/QTapi/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8787
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
