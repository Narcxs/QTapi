  <body>
    <div class="custom-titlebar">
      <img src="./logo.ico" />
      <span class="app-title"></span>
    </div>
    <div id="app"></div>
    <script defer src="https://checkout.airwallex.com/assets/elements.bundle.min.js"></script>
    <script type="text/javascript">
      function initializeCrisp() {
        if (!window.location.href.includes('synchronizer/help') && !window.location.href.includes('activity-bd')) {
          window.$crisp = [];
          window.CRISP_WEBSITE_ID = '4da20f89-7307-431c-8d34-76f813560ffb';
          (function () {
            const d = document;
            const s = d.createElement('script');
            s.src = 'https://client.crisp.chat/l.js';
            s.defer = 1;
            d.getElementsByTagName('head')[0].appendChild(s);
          })();
        }
      }
    </script>
  </body>

  <script>
    (async () => {
      const titleBar = document.querySelector('.custom-titlebar');
      // 根据不同操作系统添加对应的 class
      if (window.CLIENT_OS === 'darwin') {
        titleBar.classList.add('darwin');
      }
      if (window.CLIENT_OS === 'linux') {
        titleBar.classList.add('linux');
      }

      if (window.DIC && window.DIC.api && typeof window.DIC.api.getAppTitle === 'function') {
        // 获取应用标题并设置
        window.DIC.api.getAppTitle().then(title => {
          document.querySelector('.app-title').textContent = title;
        });
      }
      if (!window.DIC) {
        titleBar.style.display = 'none';
        document.querySelector('#app').style.height = '100%';
      }

      // 设置标题栏主题
      try {
        const currentTheme = JSON.parse(localStorage.getItem('basic:state')).themeMode || 'dark';
        titleBar.classList.add(currentTheme);
      } catch (error) {
        console.error('Failed to set title bar theme:', error);
        titleBar.classList.add('light');
      }

      // 同步器悬浮窗不需要
      const hash = new URL(location.href).hash;
      if (hash === '#/synchronizer/help') {
        titleBar.classList.add('none');
        document.querySelector('#app').style.height = '100%';
      }
    })();
  </script>
</html>

