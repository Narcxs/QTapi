# ============================================================
#  Copy this file to ".env" and fill in your real values.
#  The .env file must NEVER be committed / shared.
# ============================================================

# ---- GEXBot API (stays on the server only; sent as Bearer token) ----
GEXBOT_API_KEY=gexbot_custom_foghprgQoFhEnoxDut-V6RVi1AZOOBE91NdASJSX7cs
GEXBOT_BASE_URL=https://api.gexbot.com
GEXBOT_ALT_BASE_URL=https://api.gex.bot
USER_AGENT=GexBotNinjaTrader/1.0
DEFAULT_PERIOD=zero

# ---- Subscriptions: OFF => free / open API, no MySQL required ----
REQUIRE_SUBSCRIPTION=0
# Fill these ONLY if you set REQUIRE_SUBSCRIPTION=1 (and install mysql-connector):
# DB_HOST=your_db_host.hostinger.com
# DB_PORT=3306
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=your_db_name

# ---- Caching (seconds) ----
GEX_CACHE_TTL=15
ORDERFLOW_CACHE_TTL=3
CONV_CACHE_TTL=600
SUB_CACHE_TTL=300

# ---- Background poller (proactively caches these tickers) ----
POLL_ENABLED=1
POLLED_TICKERS=SPX,SPY,NDX,QQQ
POLL_PERIODS=zero,full,one
POLL_INTERVAL=2
# Pre-compute a futures-scaled copy (SPX->ES, NDX->NQ, ...) served via ?future=1
AUTO_CONVERT=1
# Greek profiles (delta/gamma/vanna/charm) - only 'zero' and 'one' exist upstream
POLL_GREEKS=1
GREEKS=delta,gamma,vanna,charm
GREEK_PERIODS=zero,one

# ---- US market hours (New York time, DST automatic) ----
# 1 = fetch GEXBot only [MARKET_OPEN_ET - PRE_OPEN_MINUTES -> MARKET_CLOSE_ET],
#     Monday-Friday (default: 09:28 -> 16:00 ET). The API keeps serving the
#     last cached data outside the window. 0 = fetch 24/7.
MARKET_HOURS_ONLY=1
MARKET_OPEN_ET=09:30
MARKET_CLOSE_ET=16:00
PRE_OPEN_MINUTES=2

# ---- HTTP server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8787
LOG_LEVEL=INFO

# ---- Public data API (/api/...) ----
# Optional MASTER token (admin/backdoor). Leave empty if unused.
DATA_API_TOKEN=

# ---- Per-user API tokens (issued by the Telegram bot) ----
# 0 = API open.  1 = every /api call must carry a valid ?token=...
REQUIRE_TOKEN=0
PUBLIC_BASE_URL=https://api.qtdashboard.fr
TOKEN_VALID_DAYS=7

# ---- Telegram bot ----
# Paste the token from @BotFather on the next line (no inline comment):
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=1699227126
TELEGRAM_GROUP_ID=-1004354814975
# Invite link for the "Join the group" button (optional; auto-fetched if empty
# and the bot is group admin). Example: https://t.me/+abcdEFGhij
TELEGRAM_GROUP_LINK=
# Public channel for the "Main Channel" button in the bot menus
TELEGRAM_CHANNEL_LINK=https://t.me/optionstools

# ---- ConvexValue shared account (returned by POST /cv-auth to licensed HWIDs) ----
CV_SHARED_EMAIL=quantydriver@gmail.com
CV_SHARED_PASSWORD=LetMeAloneApe-7

# ---- MenthorQ levels (shared as free text in the bot) ----
MENTHORQ_API_KEY=SofoxYNwkt1ppNczvTbTW8oTvgKEd3dI4pEWzR63
MENTHORQ_BASE_URL=https://api.menthorq.io
MENTHORQ_PLATFORM=atas
MENTHORQ_TICKERS=ES,NQ,VIX,GC
MENTHORQ_POLL_INTERVAL=600
