# ============================================================
#  Copy this file to ".env" and fill in your real values.
#  The .env file must NEVER be committed / shared.
# ============================================================

# ---- GEXBot API (stays on the server only; sent as Bearer token) ----
GEXBOT_API_KEY=gexbot_custom_W8n2eaq-_sdhS6jfQgxVgF5aRuLYXroeubnUXh1AX9Q
GEXBOT_BASE_URL=https://api.gexbot.com
GEXBOT_ALT_BASE_URL=https://api.gex.bot
USER_AGENT=GexBotNinjaTrader/1.0
DEFAULT_PERIOD=zero

# ---- Subscriptions: OFF => free / open API, no MySQL required ----
REQUIRE_SUBSCRIPTION=0
# Fill these ONLY if you set REQUIRE_SUBSCRIPTION=1 (and install mysql-connector):
# DB_HOST=your_db_host.hostinger.com
# DB_PORT=3306
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_NAME=your_db_name

# ---- Caching (seconds) ----
GEX_CACHE_TTL=15
ORDERFLOW_CACHE_TTL=3
CONV_CACHE_TTL=600
SUB_CACHE_TTL=300

# ---- Background poller (proactively caches these tickers) ----
POLL_ENABLED=1
POLLED_TICKERS=SPX,SPY,NDX,QQQ
POLL_PERIODS=zero,full,one
POLL_INTERVAL=2
# Pre-compute a futures-scaled copy (SPX->ES, NDX->NQ, ...) served via ?future=1
AUTO_CONVERT=1

# ---- HTTP server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8787
LOG_LEVEL=INFO

# ---- Public data API (/api/...) ----
# Leave empty for open access. If set, callers must pass ?token=<value>.
DATA_API_TOKEN=
