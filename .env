# ============================================================
#  QTapi - ready-to-run configuration.
#  Fill in the MySQL block if you use the subscription features
#  (/verify, /overlay, /orderflow, /data). The /api endpoints work without it.
# ============================================================

# ---- Data API key (server-side only; sent as Bearer token) ----
GEXBOT_API_KEY=gexbot_custom_W8n2eaq-_sdhS6jfQgxVgF5aRuLYXroeubnUXh1AX9Q
GEXBOT_BASE_URL=https://api.gexbot.com
GEXBOT_ALT_BASE_URL=https://api.gex.bot
USER_AGENT=QTapi/1.0
DEFAULT_PERIOD=zero

# ---- Subscriptions: OFF => free / open API, no MySQL required ----
REQUIRE_SUBSCRIPTION=0
# (The DB block below is ignored unless REQUIRE_SUBSCRIPTION=1)
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# ---- Caching (seconds) ----
GEX_CACHE_TTL=15
ORDERFLOW_CACHE_TTL=3
CONV_CACHE_TTL=600
SUB_CACHE_TTL=300

# ---- Background poller (proactively caches these tickers) ----
POLL_ENABLED=1
POLLED_TICKERS=SPX,SPY,NDX,QQQ
POLL_PERIODS=zero,full,one
POLL_INTERVAL=2
# Pre-compute a futures-scaled copy (SPX->ES, NDX->NQ, ...) served via ?future=1
AUTO_CONVERT=1
# Greek profiles (delta/gamma/vanna/charm) - only 'zero' and 'one' exist upstream
POLL_GREEKS=1
GREEKS=delta,gamma,vanna,charm
GREEK_PERIODS=zero,one

# ---- HTTP server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8787
LOG_LEVEL=INFO

# ---- Public data API (/api/...) ----
# Optional MASTER token (admin/backdoor). Leave empty if unused.
DATA_API_TOKEN=

# ---- Per-user API tokens (issued by the Telegram bot) ----
# 0 = API open (current).  1 = every /api call must carry a valid ?token=...
# Turn this to 1 ONLY once your bot is running and you've issued yourself a token.
REQUIRE_TOKEN=0
PUBLIC_BASE_URL=http://207.244.249.6:8787
TOKEN_VALID_DAYS=7

# ---- Telegram bot ----
TELEGRAM_BOT_TOKEN=8967914553:AAE2TJvUxMhNMjXe6cETBDLi2l3cda43VOU            # paste the token from @BotFather
TELEGRAM_ADMIN_ID=1699227126
TELEGRAM_GROUP_ID=-1004354814975
# Invite link for the "Join the group" button (optional; auto-fetched if empty
# and the bot is group admin). Example: https://t.me/+abcdEFGhij
TELEGRAM_GROUP_LINK=
